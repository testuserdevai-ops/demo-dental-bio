{
  "name": "dentalbio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "bun scripts/verify-staging-environment.ts && next build",
    "verify:staging-seed": "bun scripts/verify-staging-seed.ts",
    "bundle:check": "bun scripts/check-client-bundle-budgets.ts",
    "test": "bun test app lib utils --preload ./test/setup.ts --isolate",
    "typecheck": "tsc --noEmit --incremental false",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:test": "next build && next start -p 3000",
    "e2e": "playwright test",
    "e2e:start": "bun e2e/support/start-test-server.ts",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui"
  },
