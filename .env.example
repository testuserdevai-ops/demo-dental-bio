APP_URL=
NEXT_PUBLIC_BASE_URL=
APP_ENV=

# Required when APP_ENV=staging. This must be the isolated Supabase branch ref,
# never the production project ref.
STAGING_SUPABASE_PROJECT_REF=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# Staging email containment. Use a dedicated staging Resend key. Other provider
# credentials may be reused, but VERCEL_PROJECT_ID must target dentalbio-staging
# and Stripe must use test-mode keys and price IDs.
EMAIL_DELIVERY_MODE=
EMAIL_REDIRECT_TO=
EMAIL_SUBJECT_PREFIX=

NEXT_PUBLIC_ENTRI_CLIENT_SECRETS=
NEXT_PUBLIC_ENTRI_APP_ID=
NEXT_PUBLIC_ENTRI_API_BASE_URL=
NEXT_PUBLIC_ENTRI_API_KEY=

VERCEL_API_KEY=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Enables Meta's Messenger Send Dialog; without it, sharing opens
# Messenger's desktop web composer.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Must exactly match the Supabase Vault secret named verification_changed_webhook_secret.
CRON_SECRET_KEY=

# Must exactly match the Supabase Vault secret named user_changed_webhook_secret.
WEBHOOK_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VERIFF_API_KEY=
VERIFF_API_URL=
VERIFF_BASE_URL=
VERIFF_CALLBACK_URL=
VERIFF_SHARED_SECRET=
VERIFF_HMAC_SIGNATURE=

NEXT_PUBLIC_IPINFO_TOKEN=

RESEND_API_KEY=

CONTENTFUL_ENTRY_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=
CONTENTFUL_SPACE_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PRICE_FREE_MONTHLY=
PRICE_FREE_ANNUALLY=

PRICE_PRO_MONTHLY=
PRICE_PRO_ANNUALLY=

PRICE_PREMIUM_PRO_MONTHLY=
PRICE_PREMIUM_PRO_ANNUALLY=
